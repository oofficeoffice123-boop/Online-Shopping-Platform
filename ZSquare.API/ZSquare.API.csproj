    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZSquare.Application\ZSquare.Application.csproj" />
    <ProjectReference Include="..\ZSquare.Infrastructure\ZSquare.Infrastructure.csproj" />
  </ItemGroup>

